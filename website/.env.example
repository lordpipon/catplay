# Catplay Environment Configuration
# Copy this file to .env and fill in your actual values

# Database Configuration
DATABASE_URL=postgres://catuser:yourpassword@catplay-postgres:5432/catplay
POSTGRES_USER=catuser
POSTGRES_PASSWORD=yourpassword
POSTGRES_DB=catplay

# Redis Configuration
REDIS_URL=redis://catplay-redis:6379

# Authentication
PRIVATE_BETTER_AUTH_SECRET=generate_a_long_random_secret_here
PUBLIC_BETTER_AUTH_URL=https://your-domain.example

# Google OAuth (optional - for social login)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# File Upload Storage (local disk under /app/uploads in Docker)
PUBLIC_B2_BUCKET=uploads
PUBLIC_B2_ENDPOINT=
PUBLIC_B2_REGION=us-east-1

# Polar.sh (for gem purchases / payments)
POLAR_ACCESS_TOKEN=your_polar_access_token
POLAR_WEBHOOK_SECRET=your_polar_webhook_secret
PUBLIC_POLAR_PRODUCT_GEMS_500=your_polar_product_id_500
PUBLIC_POLAR_PRODUCT_GEMS_1300=your_polar_product_id_1300
PUBLIC_POLAR_PRODUCT_GEMS_2800=your_polar_product_id_2800
PUBLIC_POLAR_PRODUCT_GEMS_8000=your_polar_product_id_8000

# OpenRouter (for AI features)
OPENROUTER_API_KEY=

# Websocket URL
PUBLIC_WEBSOCKET_URL=wss://ws.your-domain.example
